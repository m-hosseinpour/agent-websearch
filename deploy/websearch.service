[Unit]
Description=websearch MCP search service (DuckDuckGo + Mwmbl)
After=network.target

[Service]
ExecStart=%h/.local/bin/websearch serve
# Optional: WEBSEARCH_TOKEN=... or any WEBSEARCH_SECTION__KEY override.
EnvironmentFile=-%h/.config/websearch/env
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
